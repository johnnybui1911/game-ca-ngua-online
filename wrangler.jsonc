{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ca-ngua-online",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDO" },
      { "name": "LOBBY", "class_name": "LobbyDO" }
    ]
  },
  // 60 summary lookups per minute per client address. Counted outside the Durable Objects.
  "ratelimits": [
    {
      "name": "ROOM_SUMMARY_LIMITER",
      "namespace_id": "1101",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO", "LobbyDO"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ca-ngua-online",
      "database_id": "5413d10a-6fa8-4bf1-ab9e-6138ce39a6a5",
      "migrations_dir": "migrations"
    }
  ]
}
