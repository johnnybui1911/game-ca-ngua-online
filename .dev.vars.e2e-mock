# Used only by the e2e run (CLOUDFLARE_ENV=e2e-mock). Fake credentials for e2e/mock-oauth; no real secrets.
GOOGLE_CLIENT_ID=mock-google-id
GOOGLE_CLIENT_SECRET=mock-google-secret
FACEBOOK_CLIENT_ID=mock-facebook-id
FACEBOOK_CLIENT_SECRET=mock-facebook-secret
X_CLIENT_ID=mock-x-id
X_CLIENT_SECRET=mock-x-secret
OAUTH_TEST_BASE_URL=http://127.0.0.1:5199
ROOM_FAST_TIMERS=1
GUEST_LIMIT_PER_HOUR=10000
# Existing specs sign in and up many times from one address; keep the auth limits out of their way.
SIGNIN_EMAIL_LIMIT=100000
SIGNIN_ADDRESS_LIMIT=100000
SIGNUP_ADDRESS_LIMIT=100000
SESSIONS_PER_USER=100000
